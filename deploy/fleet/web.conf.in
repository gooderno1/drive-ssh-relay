pid /run/drive-relay-fleet-web.pid;
error_log /var/log/nginx/drive-relay-fleet-error.log warn;
events { worker_connections 512; }
http {
  access_log off;
  server_tokens off;
  limit_req_zone $binary_remote_addr zone=relay_limit:1m rate=12r/s;
  server {
    listen @HTTPS_PORT@ ssl;
    server_name @DOMAIN@;
    ssl_certificate /etc/letsencrypt/live/@DOMAIN@/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/@DOMAIN@/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 32k;
    if ($host != @DOMAIN@) { return 444; }
    location / {
      limit_req zone=relay_limit burst=30 nodelay;
      proxy_set_header Host @AUTHORITY@;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For "";
      proxy_pass http://127.0.0.1:18441;
    }
  }
}
