[Unit]
Description=Drive Relay enrolled client SSH entry
After=network.target drive-relay-fleet.service
[Service]
Type=simple
ExecStartPre=/usr/sbin/sshd -t -f /etc/drive-relay-fleet/sshd_config
ExecStart=/usr/sbin/sshd -D -e -f /etc/drive-relay-fleet/sshd_config
Restart=on-failure
[Install]
WantedBy=multi-user.target
