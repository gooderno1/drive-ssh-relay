Port @CLIENT_PORT@
ListenAddress 0.0.0.0
AddressFamily inet
HostKey @HOST_KEY@
PidFile /run/drive-relay-client-sshd.pid
AllowUsers dr-client
AuthorizedKeysFile none
AuthorizedKeysCommand /opt/drive-relay-fleet/current/deploy/fleet/authorized-keys %u %k
AuthorizedKeysCommandUser drive-fleet
UsePAM no
AuthenticationMethods publickey
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin no
MaxSessions 0
AllowTcpForwarding local
PermitOpen 127.0.0.1:@BRIDGE_PORT@
PermitListen none
AllowStreamLocalForwarding no
GatewayPorts no
X11Forwarding no
AllowAgentForwarding no
PermitTunnel no
PermitTTY no
PermitUserRC no
ClientAliveInterval 30
ClientAliveCountMax 3
LogLevel VERBOSE
